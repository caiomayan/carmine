{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tudo no ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "503": {
            "description": "Alguma dependência está fora do ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          }
        },
        "summary": "Verifica se a API e as suas dependências (Postgres, Valkey) estão no ar",
        "tags": [
          "health"
        ]
      }
    }
  },
  "info": {
    "title": "Carmine API",
    "description": "API da plataforma Carmine, usada pelo web e pelos plugins dos Servidores Carmine.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "valkey": {
                "$ref": "#/components/schemas/DependencyCheck"
              }
            },
            "required": [
              "database",
              "valkey"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "DependencyCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "additionalProperties": false
      }
    }
  }
}
