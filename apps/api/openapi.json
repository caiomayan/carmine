{
  "openapi": "3.0.0",
  "paths": {
    "/api/health": {
      "get": {
        "operationId": "getHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tudo no ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          },
          "503": {
            "description": "Alguma dependência está fora do ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthStatus"
                }
              }
            }
          }
        },
        "summary": "Verifica se a API e as suas dependências estão no ar (só o status geral)",
        "tags": [
          "health"
        ]
      }
    },
    "/api/server/health": {
      "get": {
        "operationId": "getServerHealth",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Tudo no ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "401": {
            "description": "Chave de Servidor Carmine ausente ou inválida"
          },
          "503": {
            "description": "Alguma dependência está fora do ar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Detalhe de cada dependência da API (Postgres, Valkey)",
        "tags": [
          "server"
        ]
      }
    },
    "/api/server/player-connects": {
      "post": {
        "operationId": "registerPlayerConnect",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlayerConnect"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nome de exibição e ID público a aplicar no jogo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayerConnectResult"
                }
              }
            }
          },
          "400": {
            "description": "Corpo inválido"
          },
          "401": {
            "description": "Chave de Servidor Carmine ausente ou inválida"
          },
          "429": {
            "description": "Limite de requisições por Servidor Carmine excedido (política \"server\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"server\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"server\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Registra o connect de um jogador; cria a Conta no primeiro connect",
        "tags": [
          "server"
        ]
      }
    },
    "/api/profiles/by-steam-id/{steamId}": {
      "get": {
        "operationId": "getProfileLocation",
        "parameters": [
          {
            "name": "steamId",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SteamId64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A Conta existe",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileLocation"
                }
              }
            }
          },
          "400": {
            "description": "SteamID64 inválido"
          },
          "404": {
            "description": "Nenhuma Conta com esse SteamID64"
          },
          "429": {
            "description": "Limite de requisições por IP excedido (política \"public\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"public\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"public\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "ID público da Conta de um SteamID64, para o web redirecionar (301) ao Perfil",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/profiles/{publicId}": {
      "get": {
        "operationId": "getProfile",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "example": 10016,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "O Perfil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "404": {
            "description": "Nenhuma Conta com esse ID público"
          },
          "429": {
            "description": "Limite de requisições por IP excedido (política \"public\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"public\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"public\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Perfil público de uma Conta",
        "tags": [
          "profiles"
        ]
      }
    },
    "/api/auth/steam/login": {
      "get": {
        "operationId": "startSteamLogin",
        "parameters": [
          {
            "name": "returnTo",
            "required": false,
            "in": "query",
            "description": "Caminho interno do web para onde voltar depois do login (padrão: /)",
            "schema": {}
          }
        ],
        "responses": {
          "302": {
            "description": "Para a Steam (ou para /entrar?erro=indisponivel)"
          },
          "429": {
            "description": "Limite de requisições por IP excedido (política \"login\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"login\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"login\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Sem como contar o limite agora; tente de novo"
          }
        },
        "summary": "Começa o login Steam: redireciona para a Steam",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/steam/callback": {
      "get": {
        "operationId": "completeSteamLogin",
        "parameters": [],
        "responses": {
          "303": {
            "description": "Para a página de origem (sessão aberta) ou para /entrar?erro=<motivo>"
          },
          "429": {
            "description": "Limite de requisições por IP excedido (política \"login\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"login\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"login\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Sem como contar o limite agora; tente de novo"
          }
        },
        "summary": "Volta da Steam: verifica a asserção, reivindica a Conta e abre a sessão",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "logout",
        "parameters": [],
        "responses": {
          "204": {
            "description": "Sessão encerrada (ou já não havia sessão)"
          },
          "403": {
            "description": "Token CSRF ausente ou inválido"
          },
          "429": {
            "description": "Limite de requisições por sessão (sem sessão, IP) excedido (política \"mutations\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"mutations\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"mutations\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Sem como contar o limite agora; tente de novo"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "Encerra a sessão no servidor e apaga os cookies (exige x-csrf-token)",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getCurrentSession",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sessão ativa",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentSession"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão, ou ela expirou"
          },
          "429": {
            "description": "Limite de requisições por IP excedido (política \"public\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"public\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"public\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "503": {
            "description": "Sessões indisponíveis no momento"
          }
        },
        "security": [
          {
            "cookie": []
          }
        ],
        "summary": "A Conta da sessão atual, o token CSRF das mutações e se é o primeiro login",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/equipped/v5/{steamId}.json": {
      "get": {
        "operationId": "getEquippedV5",
        "parameters": [
          {
            "name": "steamId",
            "required": true,
            "in": "path",
            "schema": {
              "$ref": "#/components/schemas/SteamId64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Itens equipados; slot ausente usa a Arma padrão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EquippedV5"
                }
              }
            }
          },
          "400": {
            "description": "SteamID64 inválido"
          },
          "429": {
            "description": "Limite de requisições por IP excedido (política \"equipped\")",
            "headers": {
              "Retry-After": {
                "description": "Segundos até a próxima requisição ser aceita",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit": {
                "description": "Vagas restantes (r) e segundos até repor (t), ex.: \"equipped\";r=0;t=15",
                "schema": {
                  "type": "string"
                }
              },
              "RateLimit-Policy": {
                "description": "Cota (q) por janela em segundos (w), ex.: \"equipped\";q=240;w=60",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "summary": "Loadout equipado da Conta no formato do cs2-css-inventory-simulator",
        "tags": [
          "equipped"
        ]
      }
    }
  },
  "info": {
    "title": "Carmine API",
    "description": "API da plataforma Carmine, usada pelo web e pelos plugins dos Servidores Carmine.",
    "version": "0.3.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Chave do Servidor Carmine"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-carmine_session",
        "description": "Sessão do login Steam (mesma origem do web, ADR 0015)"
      }
    },
    "schemas": {
      "HealthStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "unavailable"
            ]
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "$ref": "#/components/schemas/DependencyCheck"
              },
              "valkey": {
                "$ref": "#/components/schemas/DependencyCheck"
              }
            },
            "required": [
              "database",
              "valkey"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "additionalProperties": false
      },
      "DependencyCheck": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          },
          "latencyMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "error": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "latencyMs"
        ],
        "additionalProperties": false
      },
      "PlayerConnect": {
        "type": "object",
        "properties": {
          "steamId": {
            "$ref": "#/components/schemas/SteamId64"
          },
          "steamName": {
            "type": "string",
            "maxLength": 128
          },
          "connectedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "steamId",
          "steamName"
        ]
      },
      "SteamId64": {
        "type": "string",
        "pattern": "^\\d{17}$",
        "example": "76561198000000000"
      },
      "PlayerConnectResult": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 9007199254740991
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "isFirstConnect": {
            "type": "boolean"
          }
        },
        "required": [
          "publicId",
          "displayName",
          "isFirstConnect"
        ],
        "additionalProperties": false
      },
      "ProfileLocation": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "publicId"
        ],
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "properties": {
          "publicId": {
            "type": "integer",
            "minimum": 0,
            "exclusiveMinimum": true,
            "maximum": 9007199254740991
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "avatarUrl": {
            "nullable": true,
            "type": "string",
            "format": "uri"
          },
          "steamId": {
            "$ref": "#/components/schemas/SteamId64"
          },
          "steamProfileUrl": {
            "type": "string",
            "format": "uri"
          },
          "claimed": {
            "type": "boolean"
          },
          "loadoutShowcase": {
            "$ref": "#/components/schemas/LoadoutShowcase"
          }
        },
        "required": [
          "publicId",
          "displayName",
          "avatarUrl",
          "steamId",
          "steamProfileUrl",
          "claimed",
          "loadoutShowcase"
        ],
        "additionalProperties": false
      },
      "LoadoutShowcase": {
        "type": "object",
        "properties": {
          "items": {
            "maxItems": 0,
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "CurrentSession": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Profile"
          },
          "csrfToken": {
            "type": "string",
            "minLength": 1
          },
          "firstLogin": {
            "type": "boolean"
          }
        },
        "required": [
          "account",
          "csrfToken",
          "firstLogin"
        ],
        "additionalProperties": false
      },
      "EquippedV5": {
        "type": "object",
        "properties": {
          "agents": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AgentEconItem"
            }
          },
          "ctWeapons": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/WeaponEconItem"
            }
          },
          "gloves": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/GlovesEconItem"
            }
          },
          "knives": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/MeleeEconItem"
            }
          },
          "musicKit": {
            "allOf": [
              {
                "$ref": "#/components/schemas/MusicKitEconItem"
              }
            ]
          },
          "tWeapons": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/WeaponEconItem"
            }
          }
        },
        "additionalProperties": false
      },
      "AgentEconItem": {
        "type": "object",
        "properties": {
          "def": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "hash": {
            "type": "string"
          },
          "stickers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "def": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "slot": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "def",
                "slot"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "def",
          "hash",
          "stickers"
        ],
        "additionalProperties": false
      },
      "WeaponEconItem": {
        "type": "object",
        "properties": {
          "def": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "hash": {
            "type": "string"
          },
          "nametag": {
            "type": "string"
          },
          "paint": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "seed": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "stattrak": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "stickers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "def": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "rotation": {
                  "type": "number"
                },
                "schema": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "slot": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "wear": {
                  "type": "number"
                },
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "def",
                "slot",
                "wear"
              ],
              "additionalProperties": false
            }
          },
          "keychains": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "def": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "seed": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
                },
                "slot": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991
