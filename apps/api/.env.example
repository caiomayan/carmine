# Valores para o ambiente local (infra/docker-compose.yml). Para sobrescrever,
# crie apps/api/.env (fora do git) só com as variáveis que mudam.
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=debug
DATABASE_URL=postgres://carmine:carmine@localhost:5432/carmine
VALKEY_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=2000

# Steam Web API (avatares das Contas). Crie a chave em https://steamcommunity.com/dev/apikey e
# cole-a só no apps/api/.env local; vazia, as Contas ficam com o avatar neutro.
STEAM_WEB_API_KEY=
# Requisições por minuto, por IP, ao GET /api/equipped/v5 (o servidor de jogo pede por todos).
EQUIPPED_RATE_LIMIT_PER_MINUTE=120
