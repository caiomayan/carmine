# Valores para o ambiente local (infra/docker-compose.yml). Para sobrescrever,
# crie apps/api/.env (fora do git) só com as variáveis que mudam.
NODE_ENV=development
HOST=0.0.0.0
PORT=3333
LOG_LEVEL=debug
DATABASE_URL=postgres://carmine:carmine@localhost:5432/carmine
VALKEY_URL=redis://localhost:6379
HEALTH_CHECK_TIMEOUT_MS=2000

# Steam Web API (avatares e listas de amigos). Crie a chave em https://steamcommunity.com/dev/apikey
# e cole-a só no apps/api/.env local; vazia, as Contas ficam com o avatar neutro e os amigos
# jogando, indisponíveis.
STEAM_WEB_API_KEY=
# IP real atrás do Cloudflare Tunnel (docs/operacao/rate-limit-e-ip-real.md): IPs ou redes CIDR, separados
# por vírgula, de onde o cabeçalho CF-Connecting-IP é aceito (o cloudflared e o web). Vazio:
# vale sempre o IP do socket (desenvolvimento, sem túnel).
TRUSTED_PROXIES=

# Rate limit (src/rate-limit/policies.ts): requisições por minuto de cada política.
# Login Steam (início e volta), por IP.
RATE_LIMIT_LOGIN_PER_MINUTE=20
# Leituras públicas do site (Perfis, /api/me, servidores ao vivo, amigos jogando), por IP.
RATE_LIMIT_PUBLIC_PER_MINUTE=240
# GET /api/equipped/v5, por IP (o servidor de jogo pede por todos os jogadores).
RATE_LIMIT_EQUIPPED_PER_MINUTE=120
# Mutações do site, por sessão.
RATE_LIMIT_MUTATIONS_PER_MINUTE=60
# Rotas dos plugins (/api/server/*), por Servidor Carmine.
RATE_LIMIT_SERVER_PER_MINUTE=600

# Servidores ao vivo (S06): sem batimento por esse tempo, o servidor fica offline; a varredura que
# percebe isso e avisa a home roda nesse intervalo (os dois somados: até 60 s).
SERVER_OFFLINE_AFTER_SECONDS=45
LIVE_SERVERS_SWEEP_SECONDS=5

# Login Steam (S03). Origem pública do web: a API fica em <origem>/api (mesma origem,
# ADR 0015). É o realm do OpenID e a base dos redirecionamentos depois do login.
PUBLIC_WEB_URL=http://localhost:3000
# Endpoint OpenID da Steam. Para entrar sem a Steam real em desenvolvimento, suba a Steam
# falsa (pnpm --filter @carmine/api fake-steam) e aponte para http://127.0.0.1:4555/openid/login.
STEAM_OPENID_URL=https://steamcommunity.com/openid/login
# Sessão: expira após esse tempo sem uso (renovação deslizante) e, mesmo em uso, após o absoluto.
SESSION_IDLE_TTL_SECONDS=1209600
SESSION_ABSOLUTE_TTL_SECONDS=7776000
