{
  "name": "@carmine/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest build -p tsconfig.build.json && pnpm db:migrate && nest start -p tsconfig.build.json --watch --preserveWatchOutput --exec \"node --env-file=.env.example --env-file-if-exists=.env\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file=.env.example --env-file-if-exists=.env dist/database/migrate.cli.js",
    "servers": "node --env-file=.env.example --env-file-if-exists=.env dist/game-servers/servers.cli.js",
    "vip": "node --env-file=.env.example --env-file-if-exists=.env dist/vip/vip.cli.js",
    "payments": "node --env-file=.env.example --env-file-if-exists=.env dist/payments/payments.cli.js",
    "staff": "node --env-file=.env.example --env-file-if-exists=.env dist/staff/staff.cli.js",
    "accounts": "node --env-file=.env.example --env-file-if-exists=.env dist/accounts/accounts.cli.js",
    "fake-steam": "node test/support/fake-steam-openid.cli.ts",
    "openapi:generate": "nest build -p tsconfig.build.json && node dist/openapi/generate.cli.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@carmine/contracts": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.6",
    "@ianlucas/cs2-lib": "catalog:",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@nestjs/swagger": "12.0.2",
    "@sentry/node": "11.8.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.3.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@swc/core": "1.16.13",
    "@testcontainers/postgresql": "12.2.0",
    "@testcontainers/valkey": "12.2.0",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "drizzle-kit": "0.31.11",
    "pino-pretty": "13.2.0",
    "testcontainers": "12.2.0",
    "typescript": "catalog:",
    "unplugin-swc": "2.0.0",
    "vitest": "catalog:"
  }
}
