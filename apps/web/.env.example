# Redes da Carmine no rodapé (lidas no build). Rede sem endereço https não aparece.
# Discord: sem valor, vale o convite oficial definido em src/lib/social.ts.
NEXT_PUBLIC_DISCORD_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Vitrine interna dos componentes em /dev/componentes (dev e E2E). Em produção fica desligada (404).
CARMINE_UI_GALLERY=

# Erros de i18n (variável faltando, chave inexistente) derrubam a página em vez de só registrar
# no log do servidor. Ligado no E2E; útil também em desenvolvimento.
CARMINE_STRICT_I18N=

# Contagem de páginas (A1d, ADR 0021): a chave pública do projeto do PostHog (UE), lida em tempo de execução.
# Vazio desliga: nada roda no navegador e a CSP não muda. POSTHOG_HOST só se não for o padrão (https://eu.i.posthog.com).
# ANALYTICS_DRIVER=log (a homologação) também desliga o navegador: só a API registra no log.
POSTHOG_API_KEY=
POSTHOG_HOST=

# Para onde o Next repassa /api/* em desenvolvimento e no E2E (lido no build; ADR 0015).
# Em produção o Cloudflare Tunnel manda /api/* direto para a API.
API_URL=http://localhost:3333
