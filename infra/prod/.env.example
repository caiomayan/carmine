# Variáveis de produção (S09). Copie para /opt/carmine/.env NA VM (fora do git, chmod 600) e
# preencha. O passo a passo, em ordem, está em docs/operacao/checklist-do-dono.md.
# Senhas: use só hexadecimal (`openssl rand -hex 24`), porque entram em URLs.

# --- Banco e cache ---------------------------------------------------------------------------
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# --- Cloudflare Tunnel -----------------------------------------------------------------------
# Painel Zero Trust > Networks > Tunnels > o túnel > "Install and run a connector": o texto longo
# depois de `--token`.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Steam -----------------------------------------------------------------------------------
# https://steamcommunity.com/dev/apikey (avatares e "Seus amigos jogando agora"). Vazia, as
# Contas ficam com o avatar neutro e os amigos jogando, indisponíveis.
STEAM_WEB_API_KEY=

# --- Backup no Cloudflare R2 -----------------------------------------------------------------
# R2 > o bucket > Manage R2 API Tokens (permissão "Object Read & Write", só neste bucket).
R2_BUCKET=
# https://<ID DA CONTA>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Dias que um dump fica no R2 (a poda roda a cada backup).
BACKUP_RETENTION_DAYS=30
# Opcional: URL de ping de um monitor de cron (Better Stack Heartbeat, healthchecks.io) que o
# backup chama quando conclui; se o ping parar de chegar, o monitor avisa.
BACKUP_HEARTBEAT_URL=

# --- Foto de perfil (R2 de mídia, ADR 0022) ---------------------------------------------------
# Dois buckets NOVOS, separados do de backup (que nunca fica público): um público (domínio
# img.stcarmine.com) e um privado (fotos removidas, 30 dias). Passo a passo: docs/operacao/foto-de-perfil.md.
# Vazio desliga a funcionalidade (as seis primeiras precisam estar todas preenchidas).
R2_MEDIA_ENDPOINT=
R2_MEDIA_ACCESS_KEY_ID=
R2_MEDIA_SECRET_ACCESS_KEY=
R2_MEDIA_PUBLIC_BUCKET=
R2_MEDIA_PRIVATE_BUCKET=
# https://img.stcarmine.com
MEDIA_PUBLIC_URL=
# Opcional, mas configure em produção: tira a foto apagada do cache da CDN (token só com "Cache Purge").
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_TOKEN=

# --- Alertas e erros -------------------------------------------------------------------------
# Webhook do canal de alertas do Discord (Configurações do canal > Integrações > Webhooks).
# Vazio desliga os alertas de servidor offline e de falha de backup.
DISCORD_ALERT_WEBHOOK_URL=
# Webhook do canal da STAFF (outro canal, só para a equipe): avisa cada Denúncia nova feita no jogo
# (motivo, alvo, servidor e link da fila). Vazio desliga o aviso; a fila do painel funciona igual.
STAFF_REPORTS_WEBHOOK_URL=
# Discord integrado (S15): vínculo da Conta, cargos (Jogador, VIP, Staff, Dono) e a mensagem de status
# dos servidores. Vazio desliga tudo, sem erro. Passo a passo: docs/operacao/discord.md.
# Application ID e Client Secret (Developer Portal > OAuth2); Token do bot (Bot > Reset Token).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# ID do servidor do Discord e dos cargos (modo desenvolvedor > botão direito > Copiar ID).
DISCORD_GUILD_ID=
DISCORD_ROLE_PLAYER_ID=
DISCORD_ROLE_VIP_ID=
DISCORD_ROLE_STAFF_ID=
DISCORD_ROLE_OWNER_ID=
# Canal onde o bot mantém a mensagem de status (ele edita a mesma). Vazio: sem mensagem de status.
DISCORD_STATUS_CHANNEL_ID=
# DSN de cada projeto do Sentry (um para a API, um para o web: servidor e navegador). Vazio desliga.
API_SENTRY_DSN=
WEB_SENTRY_DSN=

# --- Opcionais -------------------------------------------------------------------------------
LOG_LEVEL=info
