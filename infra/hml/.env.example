# Variáveis da homologação. O bootstrap.sh cria /opt/carmine-hml/.env a partir deste modelo, já com
# as senhas e o segredo da demonstração sorteados; falta só o token do túnel (e, se quiser, o resto).
# Fora do git, chmod 640. Passo a passo: docs/operacao/homologacao.md.

# --- Banco e cache (sorteadas pelo bootstrap; só hexadecimal, porque entram em URLs) ------------
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# --- Cloudflare Tunnel -----------------------------------------------------------------------
# Do túnel NOVO `carmine-hml` (Zero Trust > Networks > Tunnels > o túnel > "Install and run a
# connector": o texto longo depois de `--token`). Nunca o token do túnel de produção.
CLOUDFLARE_TUNNEL_TOKEN=

# --- Steam -----------------------------------------------------------------------------------
# Opcional. Vazia, as Contas ficam com o avatar neutro (o login Steam funciona do mesmo jeito: o
# OpenID não precisa de chave). Dá para reaproveitar a chave de produção.
STEAM_WEB_API_KEY=

# --- Demonstração ----------------------------------------------------------------------------
# true: o deploy semeia as contas, servidores, estatísticas, ranking, inventário e loadout fictícios
# e liga o simulador de partidas. false: a homologação sobe vazia.
DEMO_ENABLED=true
# Sorteado pelo bootstrap. Deriva as chaves dos servidores fictícios; não é de produção.
DEMO_SEED_SECRET=
# Opcional: o SteamID64 do dono. A Conta dele ganha VIP, inventário, loadout, presets, estatísticas
# e o papel de Dono (para validar também o painel da Staff).
DEMO_OWNER_STEAM_ID=

# --- Pagamentos (S14) ------------------------------------------------------------------------
# Nada a preencher: a homologação vende com o provedor FALSO e guarda os Itens VIP por conta do próprio
# compose, e a chave que cifra o CPF do Pagador é sorteada sozinha na primeira subida (volume
# `payments-key`; o `reset` a troca junto com o banco).

# --- Opcionais -------------------------------------------------------------------------------
LOG_LEVEL=info
