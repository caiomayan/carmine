# Servidor Carmine "@PROFILE@" — segredos e ajustes deste perfil. Fora do git, 0600 root.
# Depois de editar:  sudo systemctl restart carmine-cs2@@PROFILE@
# (porta, mapa e modo vêm de infra/cs2/profiles/@PROFILE@/profile.json, não daqui)

# Chave do Servidor Carmine na API (ADR 0005). Crie na VM de produção:
#   /opt/carmine/bin/dc exec api node dist/game-servers/servers.cli.js create --name @PROFILE@ --mode <retake|deathmatch> --address <ip>:<porta>
# (confira o comando exato em docs/operacao/aws-beta-cs2.md). Uma chave por servidor, nunca compartilhada.
CARMINE_API_KEY=

# Token GSLT deste servidor (https://steamcommunity.com/dev/managegameservers, App ID 730), um por
# servidor. Para trocar um token banido: edite esta linha e reinicie (docs/operacao/troca-de-token-gslt.md).
CS2_GSLT=

CARMINE_API_BASE_URL=@API_BASE_URL@
# O que o !ws mostra como endereço do site.
CARMINE_WEB_DISPLAY_URL=@WEB_DISPLAY_URL@

# Argumentos extras para o cs2 (opcional), ex.: +net_public_adr 203.0.113.10
CS2_EXTRA_ARGS=
