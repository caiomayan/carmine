+    public object? GetPlayerPreference(CCSPlayerController player, string name)
+    {
+        return player != null && player.IsValid && playerData.TryGetValue(player.Slot, out var data) && data.Preferences.TryGetValue(name, out var value)
+            ? value
+            : null;
+    }
+
+    public bool SetPlayerPreference(CCSPlayerController player, string name, object value)
+    {
+        if (player == null || !player.IsValid || !playerData.TryGetValue(player.Slot, out var data))
+            return false;
+
+        if (data.Preferences.TryGetValue(name, out var current) && current.GetType() != value.GetType())
+            return false;
+
+        data.Preferences[name] = value;
+        return true;
+    }
+
     public Preference? RegisterPreference(string name, PreferencesBooleanData data, bool vipOnly = false)
     {
         var preference = Preference.RegisterPreference(name, data, vipOnly);
