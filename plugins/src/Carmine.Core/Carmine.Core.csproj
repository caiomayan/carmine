<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Plugin próprio dos Servidores Carmine (Conta, Nome de exibição, integração com a API).
    Saída para o servidor: bin/<Configuração>/net10.0/ → addons/counterstrikesharp/plugins/Carmine.Core/
  -->
  <PropertyGroup>
    <!-- O CounterStrikeSharp carrega as dependências a partir da pasta do plugin. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- Fornecido pelo próprio CounterStrikeSharp no servidor: não vai para a pasta do plugin. -->
    <PackageReference Include="CounterStrikeSharp.API" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Carmine.Api.Client/Carmine.Api.Client.csproj" />
  </ItemGroup>
</Project>
